# Copy to .env for local development. Never commit .env.

# API (apps/api)
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Expo Web dev server
CORS_ORIGINS=http://localhost:8081

# PostgreSQL (docker-compose)
DATABASE_URL=postgres://etkin:etkin@localhost:5432/etkin?sslmode=disable

# Redis (docker-compose)
REDIS_URL=redis://localhost:6379/0

# dbmate
DBMATE_MIGRATIONS_DIR=./db/migrations
DBMATE_SCHEMA_FILE=./db/schema.sql
# schema.sql dump needs a local pg_dump >= 18; flip to false once installed
DBMATE_NO_DUMP_SCHEMA=true
