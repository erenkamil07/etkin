# Copy to .env for local development. Never commit .env.

# API (apps/api)
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Expo Web dev server
CORS_ORIGINS=http://localhost:8081
# true runs the outbox worker inside the API (one process); locally `pnpm dev:worker` does it instead
RUN_WORKER_IN_API=false
# Dev-only signing key (min 32 chars). Production sets its own in the host's secret variables (Railway).
JWT_ACCESS_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
# Dev-only QR master key (base64, 32+ bytes). Generate your own with: openssl rand -base64 32
QR_MASTER_KEY=moVtnpTD1KcuHtr3L0d+xIKgi1uAY8QXejCOGpvfe2U=

# PostgreSQL (docker-compose)
DATABASE_URL=postgres://etkin:etkin@localhost:5432/etkin?sslmode=disable

# Redis (docker-compose)
REDIS_URL=redis://localhost:6379/0

# dbmate
DBMATE_MIGRATIONS_DIR=./db/migrations
DBMATE_SCHEMA_FILE=./db/schema.sql
# schema.sql dump needs a local pg_dump >= 18; flip to false once installed
DBMATE_NO_DUMP_SCHEMA=true
